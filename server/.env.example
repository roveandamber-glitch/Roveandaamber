# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Authentication
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/roveandamber?retryWrites=true&w=majority

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_key_secret_here
RAZORPAY_CURRENCY=INR

# 7. Automated Email Notification Suite (SMTP / Nodemailer)
# (If left empty, email service runs safely in simulated console logging mode)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=concierge@roveandamber.com
SMTP_PASS=your_app_specific_password_here
EMAIL_FROM="ROVE & AMBER Concierge" <concierge@roveandamber.com>
